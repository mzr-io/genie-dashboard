[
    {
        "name": "a moved item pushes the one it lands on down, just far enough",
        "moved": { "a": { "col": 6, "row": 0, "width": 6, "height": "small" } },
        "others": {
            "b": { "col": 6, "row": 0, "width": 6, "height": "small" }
