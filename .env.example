APP_NAME=Dashflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Same-origin SPA cookie auth for /api/v1 (Sanctum)
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker Compose stack (compose.yaml sets these inside the containers) ---
# Compose reads APP_KEY from this file or your shell and refuses to start without it.
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=valkey
# HORIZON_ENV=connector      # connector or compute; set per worker role by the entrypoint
# DASHFLOW_WEB_HOST_PORT=8080
# DASHFLOW_REALTIME_HOST_PORT=8081
# POSTGRES_DB=dashflow
# POSTGRES_USER=dashflow
# POSTGRES_PASSWORD=dashflow
# REVERB_APP_ID=dashflow-dev
# REVERB_APP_KEY=dashflow-dev-key
# REVERB_APP_SECRET=dashflow-dev-secret
