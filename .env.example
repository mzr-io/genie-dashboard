APP_NAME=Dashflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_CHANNEL=stdout   # JSON lines on stdout (set by the Compose stack)

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Same-origin SPA cookie auth for /api/v1 (Sanctum)
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis

# Valkey: two stores on two instances (queue: noeviction, cache: LRU, TTL on every key).
# Each process role connects as its own ACL user (VALKEY_USERNAME / VALKEY_PASSWORD); a store may
# override them with VALKEY_<QUEUE|CACHE>_USERNAME / _PASSWORD. Used when QUEUE_CONNECTION=redis.
# VALKEY_QUEUE_HOST=127.0.0.1
# VALKEY_QUEUE_PORT=6379
# VALKEY_QUEUE_SCHEME=tcp          # tls in the Compose stack
# VALKEY_CACHE_HOST=127.0.0.1
# VALKEY_CACHE_PORT=6379
# VALKEY_CACHE_SCHEME=tcp
# VALKEY_USERNAME=
# VALKEY_PASSWORD=
# VALKEY_TLS_CA=                   # CA certificate path for the tls scheme
# VALKEY_TLS_VERIFY=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker Compose stack (compose.yaml sets these inside the containers) ---
# Compose reads APP_KEY from this file or your shell and refuses to start without it.
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# VALKEY_QUEUE_HOST=valkey-queue
# VALKEY_CACHE_HOST=valkey-cache
# VALKEY_PASSWORD_WEB=...          # per-role ACL passwords (also _REALTIME, _SCHEDULER, _WORKER_CONNECTOR, _WORKER_COMPUTE, _HEALTH)
# VALKEY_CACHE_MAXMEMORY=256mb     # development value; size it for your deployment
# VALKEY_QUEUE_MAXMEMORY=
# DB_PGBOUNCER=false               # true: transaction-mode pooling settings (no server-side prepared statements)
# HORIZON_ENV=connector      # connector or compute; set per worker role by the entrypoint
# DASHFLOW_WEB_HOST_PORT=8080
# DASHFLOW_REALTIME_HOST_PORT=8081
# POSTGRES_DB=dashflow
# POSTGRES_USER=dashflow
# POSTGRES_PASSWORD=dashflow       # bootstrap superuser only; no service connects as it
# Database roles (docker/postgres/initdb.sh). Services connect as `app`; only the migrator service holds `migrator`.
# POSTGRES_APP_PASSWORD=dashflow-dev-app
# POSTGRES_MIGRATOR_PASSWORD=dashflow-dev-migrator
# POSTGRES_MAINTENANCE_PASSWORD=dashflow-dev-maintenance
# POSTGRES_SYSTEM_PASSWORD=dashflow-dev-system
# POSTGRES_OPERATOR_PASSWORD=dashflow-dev-operator
# DB_MIGRATOR_USERNAME=migrator    # `migrate --database=migrator`; DB_MIGRATOR_HOST/PORT/DATABASE/PASSWORD default to the DB_* values
# DB_MIGRATOR_PASSWORD=
# DB_SYSTEM_USERNAME=system        # outbox relay role; given to worker-compute only (DB_SYSTEM_HOST/PORT/DATABASE default to DB_*, connect straight to PostgreSQL)
# DB_SYSTEM_PASSWORD=
# DB_SYSTEM_HOST=postgres          # set explicitly: the relay holds row locks, so it must bypass PgBouncer
# DB_SYSTEM_PORT=5432
# POSTGRES_OPERATOR_PASSWORD=dashflow-dev-operator   # password of role `operator` (docker/postgres/initdb.sh); the `operator` Compose service passes it as DB_OPERATOR_PASSWORD
# DB_OPERATOR_USERNAME=operator    # `dashflow:workspace:create` role; given to the one-off `operator` Compose service only (DB_OPERATOR_HOST/PORT/DATABASE default to DB_*)
# DB_OPERATOR_PASSWORD=
# DASHFLOW_INVITATION_LIFETIME=    # pending_input: whole hours an invitation link is valid; the command refuses to run while unset
# DB_SECURITY_HOST=postgres        # second `app` connection for security audit events; also bypasses PgBouncer
# DB_SECURITY_PORT=5432            # (DB_SECURITY_DATABASE/USERNAME/PASSWORD default to the DB_* values)
# REVERB_APP_ID=dashflow-dev
# REVERB_APP_KEY=dashflow-dev-key
# REVERB_APP_SECRET=dashflow-dev-secret

# --- OpenTelemetry (OTLP export; real environment variables, read by the SDK) ---
# Unset endpoint: the app runs and logs one warning per process.
# OTEL_SERVICE_NAME=dashflow
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# --- Tunables (AR-57): every one is pending_input; unset means "not yet supplied" ---
# See config/dashflow.php for the full list and the variable of each setting. Only these two have a value:
# DASHFLOW_DISPATCH_TICK=5         # proposed default, seconds
# DASHFLOW_REQUIRE_HTTPS=false
# DASHFLOW_SIGN_IN_MAX_ATTEMPTS=   # pending_input: sign-in attempts per email and IP; unset = Fortify's 5 per minute
# DASHFLOW_SIGN_IN_DECAY_SECONDS=  # pending_input: seconds before the sign-in attempt count resets; unset = 60
# DASHFLOW_RESET_LINK_LIFETIME=   # pending_input: whole minutes a password-reset link stays valid; unset = the starter kit's 60
# DASHFLOW_RESET_REQUEST_MAX_ATTEMPTS=  # pending_input: reset-link requests per email and IP; unset = 5 per minute
# DASHFLOW_RESET_REQUEST_DECAY_SECONDS= # pending_input: seconds before the reset-request count resets; unset = 60
# DASHFLOW_LISTS_MAX_PAGE_SIZE=    # pending_input: largest page a list may return; unset = 15 rows per page
# DASHFLOW_AVATAR_MAX_BYTES=       # pending_input: largest avatar upload in bytes; unset = PHP's upload_max_filesize
# DASHFLOW_REMEMBER_ME_DURATION=   # pending_input: whole minutes a Remember-me cookie lasts; unset = Remember me adds nothing
