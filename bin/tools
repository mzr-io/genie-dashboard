#!/usr/bin/env bash
# Run PHP, Composer and Node inside the Dashflow tools image (PHP 8.5, Node 22).
# Usage: bin/tools <command...>   e.g. bin/tools composer install
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${DASHFLOW_TOOLS_IMAGE:-dashflow-tools:php8.5-node22}"
CACHE="${DASHFLOW_TOOLS_CACHE:-$HOME/.cache/dashflow-tools}"

if [[ -z "$(docker images -q "$IMAGE" 2>/dev/null)" ]]; then
    docker build -t "$IMAGE" "$ROOT/docker/tools"
fi

mkdir -p "$CACHE/composer" "$CACHE/npm"

TTY=()
[[ -t 0 && -t 1 ]] && TTY=(-t)

# `composer ci:check` and `composer test:database` need PostgreSQL 18 and PgBouncer. The tools container has
# no Docker socket, so the host starts them first (bin/test-db) and tears them down afterwards.
# If they cannot start, the command fails: there is no skip. DASHFLOW_KEEP_TEST_DB=1 leaves them running.
WITH_DB=0
if [[ "${1:-}" == "composer" && ( "${2:-}" == "ci:check" || "${2:-}" == "test:database" || "${2:-}" == "test:security" ) ]]; then
    WITH_DB=1
    # Registered before `up`, so a partial start is torn down too.
    if [[ -z "${DASHFLOW_KEEP_TEST_DB:-}" ]]; then
        trap '"$ROOT/bin/test-db" down >/dev/null 2>&1 || true' EXIT
    fi
    "$ROOT/bin/test-db" up
fi

RUN=(docker run --rm -i "${TTY[@]}" \
    --user "$(id -u):$(id -g)" \
    --network host \
    -e HOME=/tmp \
    -e COMPOSER_HOME=/cache/composer \
    -e COMPOSER_CACHE_DIR=/cache/composer/cache \
    -e npm_config_cache=/cache/npm \
    -v "$ROOT:/app" \
    -v "$CACHE:/cache" \
    -w /app \
    "$IMAGE" "$@")

if [[ "$WITH_DB" == 1 ]]; then
    # The restore check (Story 1.25) runs on the host after the Database suite, against the same containers,
    # and fails the command when it fails (the PHP container has no Docker or pg_dump).
    status=0
    "${RUN[@]}" || status=$?
    if [[ "$status" == 0 ]]; then
        # Every WITH_DB command (ci:check, test:database, test:security) ran the Database suite. The global
        # table list comes from the PHP source of truth, read in the tools container.
        DASHFLOW_GLOBAL_TABLES="$("$0" php -r 'echo implode(",", (require "tests/Architecture/dependencies.php")["global_tables"]);')" || status=$?
        if [[ "$status" == 0 ]]; then
            export DASHFLOW_GLOBAL_TABLES
            "$ROOT/bin/test-restore" || status=$?
        fi
    fi
    exit "$status"
else
    exec "${RUN[@]}"
fi
