# Application roles. Queue store: queues, locks, rate limits, Reverb fan-out, Horizon.
user web on >__PASSWORD_WEB__ ~* &* +@all -@admin -@dangerous
user scheduler on >__PASSWORD_SCHEDULER__ ~* &* +@all -@admin -@dangerous
user worker-connector on >__PASSWORD_WORKER_CONNECTOR__ ~* &* +@all -@admin -@dangerous
user worker-compute on >__PASSWORD_WORKER_COMPUTE__ ~* &* +@all -@admin -@dangerous
# realtime only publishes and subscribes (Reverb scaling); it can read and write no keys.
# Reverb's async client can only AUTH with a password (no username), which authenticates as
# the `default` user, so on this store the realtime role is `default`. Nobody else is.
user default on >__PASSWORD_REALTIME__ resetkeys &* -@all +@pubsub +@connection
# Health checks and INFO for operators: no key access.
user health on >__PASSWORD_HEALTH__ resetkeys -@all +ping +info +@connection
